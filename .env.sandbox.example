APP_ENV=sandbox
FBR_MODE=sandbox
FBR_MOCK=false
APP_URL=https://sandbox-invoice.example.com
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1
DATABASE_URL=postgres://fbr_digital_invoice:REPLACE_SANDBOX_DB_PASSWORD@sandbox-db:5432/fbr_digital_invoice_sandbox
SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SANDBOX_SECRET
FBR_GET_TOKEN=REPLACE_SANDBOX_REFERENCE_TOKEN
FBR_POST_TOKEN=REPLACE_SANDBOX_SUBMISSION_TOKEN
# Replace sample seller details with your registered business details.
SELLER_NAME="fbr-digital-invoice"
SELLER_NTN=1234567
SELLER_STRN=
SELLER_PROVINCE=Punjab
SELLER_ADDRESS="Replace with your registered business address"
SMTP_HOST=
MAIL_FROM="fbr-digital-invoice <invoices@example.com>"
