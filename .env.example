# Local sandbox only. Copy to .env and generate a random SESSION_SECRET.
APP_ENV=sandbox
FBR_MODE=sandbox
FBR_MOCK=true
APP_URL=http://localhost:3100
HOST=127.0.0.1
PORT=3100
TRUST_PROXY=0
DATABASE_URL=postgres://fbr_digital_invoice:REPLACE_PASSWORD@127.0.0.1:5432/fbr_digital_invoice_sandbox
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Replace sample seller details with your registered business details.
SELLER_NAME="fbr-digital-invoice"
SELLER_NTN=1234567
SELLER_STRN=
SELLER_PROVINCE=Punjab
SELLER_ADDRESS="Replace with your registered business address"
FBR_GET_TOKEN=
FBR_POST_TOKEN=
# Optional email. Without SMTP, administrators receive temporary passwords once.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="fbr-digital-invoice <invoices@example.invalid>"
