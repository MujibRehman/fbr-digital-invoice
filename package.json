{
  "name": "fbr-digital-invoice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private fbr-digital-invoice invoicing with PostgreSQL, employee sessions, and isolated FBR deployments",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "npm run build && node scripts/dev.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "local": "node scripts/local.js",
    "check:deploy": "node scripts/check-deploy-env.js",
    "reconcile": "node scripts/reconcile.js",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "prelocal": "npm run build",
    "test:frontend": "vitest run",
    "test:all": "npm run check && npm test && npm run test:frontend",
    "pretest": "npm run build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "^18.1.0-beta.15",
    "jsdom": "^29.1.1",
    "supertest": "^7.1.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
